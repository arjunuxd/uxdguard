version: 1

scan:
  max_file_size_bytes: 1048576
  follow_symlinks: false
  exclusions:
    - ".git/**"
    - "vendor/**"
    - "node_modules/**"
    - "dist/**"
    - "build/**"

policy:
  fail_on:
    - critical
    - high

# Optional: enable, disable, or reclassify rules.
# rules:
#   enable: []
#   disable:
#     - UXD-SEC-203
#   severity:
#     UXD-SEC-203: low

# Optional external scanners. Disabled by default.
# external:
#   gitleaks:
#     enabled: false
#     require: false
#     path: ""
#     timeout: "60s"
#   semgrep:
#     enabled: false
#     require: false
#     path: ""
#     timeout: "120s"
#     options:
#       config: ""
